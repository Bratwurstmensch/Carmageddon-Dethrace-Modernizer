*.exe
*.dll
*.pdb

# Common build output
/build/
/out/
/dist/
.vs/
.vscode/
CMakeFiles/
CMakeCache.txt

# Local backups / scratch
*.bak
*.tmp
*.orig
*.rej
Thumbs.db
Desktop.ini
